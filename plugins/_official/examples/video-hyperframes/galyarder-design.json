{
  "$schema": "https://galyarder-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-video-hyperframes",
  "title": "Hyperframes Video",
  "version": "0.1.0",
  "description": "Hyperframes / Remotion-compatible continuous frame animation with autoplay support.",
  "license": "MIT",
  "author": {
    "name": "Galyarder Design",
    "url": "https://github.com/galyarderlabs"
  },
  "homepage": "https://github.com/galyarderlabs/galyarder-design/tree/main/plugins/_official/examples/video-hyperframes",
  "tags": [
    "example",
    "first-party",
    "video",
    "hyperframes",
    "remotion",
    "untitled"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "gd": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "video",
    "scenario": "video",
    "surface": "video",
    "featured": 0.13,
    "preview": {
      "type": "html",
      "entry": "./example.html"
    },
    "useCase": {
      "query": {
        "en": "Use the Hyperframes Video template to turn my content into a Hyperframes / Remotion-compatible continuous frame animation with autoplay support. Preserve the template's visual signature, use real content and data, and avoid lorem ipsum or placeholder images."
      },
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Hyperframes Video",
          "title_i18n": {
            "en": "Hyperframes Video"
          }
        }
      ]
    },
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  },
  "title_i18n": {
    "en": "Hyperframes Video"
  },
  "description_i18n": {
    "en": "Hyperframes / Remotion-compatible continuous frame animation with autoplay support."
  }
}
