{
  "$schema": "https://galyarder-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-html-ppt-weekly-report",
  "title": "Html Ppt Weekly Report",
  "version": "0.1.0",
  "description": "Team weekly / status-update deck — corporate clarity, 8-cell KPI grid, shipped list, 8-week bar chart, next-week table. Use for weekly reports, business reviews, team status updates, and exec dashboards.",
  "license": "MIT",
  "author": {
    "name": "Galyarder Design",
    "url": "https://github.com/galyarderlabs"
  },
  "homepage": "https://github.com/galyarderlabs/galyarder-design/tree/main/plugins/_official/examples/html-ppt-weekly-report",
  "tags": [
    "example",
    "first-party",
    "deck",
    "operations",
    "web",
    "weekly-report",
    "untitled",
    "status-update",
    "team-report",
    "business-review",
    "wbr"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "gd": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "deck",
    "scenario": "operations",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html"
    },
    "useCase": {
      "query": {
        "en": "Use the html-ppt-weekly-report template to generate a weekly report deck (7 pages). First ask me four things: this week's date range, 3-5 core KPI numbers, shipped/completed items, and next week's plans and risks. Then fill the template with the 8-week bar chart and next-week table."
      },
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Html Ppt Weekly Report"
        }
      ]
    },
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
