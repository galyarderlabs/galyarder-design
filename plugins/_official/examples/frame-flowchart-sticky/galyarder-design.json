{
  "$schema": "https://galyarder-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-frame-flowchart-sticky",
  "title": "Sticky Flowchart Frame",
  "version": "0.1.0",
  "description": "SVG curve connectors, sticky-note nodes, and cursor interaction with a whiteboard-brainstorm feel.",
  "license": "MIT",
  "author": {
    "name": "Galyarder Design",
    "url": "https://github.com/galyarderlabs"
  },
  "homepage": "https://github.com/galyarderlabs/galyarder-design/tree/main/plugins/_official/examples/frame-flowchart-sticky",
  "tags": [
    "example",
    "first-party",
    "video",
    "operations",
    "flowchart",
    "diagram",
    "sticky",
    "whiteboard",
    "frame"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "gd": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "video",
    "scenario": "operations",
    "surface": "video",
    "preview": {
      "type": "html",
      "entry": "./example.html"
    },
    "useCase": {
      "query": {
        "en": "Use the Sticky Flowchart Frame template to turn my content into a whiteboard-brainstorm frame with SVG curve connectors, sticky-note nodes, and cursor interaction. Preserve the template's visual signature, use real content and data, and avoid lorem ipsum or placeholder images."
      },
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Sticky Flowchart Frame",
          "title_i18n": {
            "en": "Sticky Flowchart Frame"
          }
        }
      ]
    },
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  },
  "title_i18n": {
    "en": "Sticky Flowchart Frame"
  },
  "description_i18n": {
    "en": "SVG curve connectors, sticky-note nodes, and cursor interaction with a whiteboard-brainstorm feel."
  }
}
