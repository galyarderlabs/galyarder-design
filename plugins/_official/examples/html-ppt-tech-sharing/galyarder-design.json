{
  "$schema": "https://galyarder-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-html-ppt-tech-sharing",
  "title": "Html Ppt Tech Sharing",
  "version": "0.1.0",
  "description": "Conference / internal tech-talk deck — GitHub-dark, JetBrains Mono, terminal code blocks, agenda + Q&A pages. Use for engineering presentations, internal sharing sessions, conference talks, and code-heavy walkthroughs.",
  "license": "MIT",
  "author": {
    "name": "Galyarder Design",
    "url": "https://github.com/galyarderlabs"
  },
  "homepage": "https://github.com/galyarderlabs/galyarder-design/tree/main/plugins/_official/examples/html-ppt-tech-sharing",
  "tags": [
    "example",
    "first-party",
    "deck",
    "engineering",
    "web",
    "tech-sharing",
    "tech-talk",
    "untitled",
    "engineering-talk",
    "conference-talk",
    "dev-talk"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "gd": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "deck",
    "scenario": "engineering",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html"
    },
    "useCase": {
      "query": {
        "en": "Use the html-ppt-tech-sharing template to create an 8-page technical sharing deck. First confirm the topic, target audience (coworkers, community, or customers), and whether to include code snippets and benchmarks. Use a GitHub dark theme with JetBrains Mono, and include agenda and Q&A slides."
      },
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Html Ppt Tech Sharing"
        }
      ]
    },
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
