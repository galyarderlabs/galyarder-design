{
  "$schema": "https://galyarder-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-card-twitter",
  "title": "Twitter Share Card",
  "version": "0.1.0",
  "description": "Twitter quote or data card designed to pair with a post.",
  "license": "MIT",
  "author": {
    "name": "Galyarder Design",
    "url": "https://github.com/galyarderlabs"
  },
  "homepage": "https://github.com/galyarderlabs/galyarder-design/tree/main/plugins/_official/examples/card-twitter",
  "tags": [
    "example",
    "first-party",
    "prototype",
    "marketing",
    "web",
    "desktop",
    "twitter",
    "x",
    "quote",
    "untitled"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "gd": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "prototype",
    "platform": "desktop",
    "scenario": "marketing",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html"
    },
    "useCase": {
      "query": {
        "en": "Use the Twitter Share Card template to turn my content into a Twitter quote or data card designed to pair with a post. Preserve the template's visual signature, use real content and data, and avoid lorem ipsum or placeholder images."
      },
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Twitter Share Card",
          "title_i18n": {
            "en": "Twitter Share Card"
          }
        }
      ]
    },
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./example.html"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  },
  "title_i18n": {
    "en": "Twitter Share Card"
  },
  "description_i18n": {
    "en": "Twitter quote or data card designed to pair with a post."
  }
}
